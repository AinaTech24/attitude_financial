# ====================================================================
# ATTITUDE FINANCIAL SERVICES - PRODUCTION APACHE CONFIGURATION (.htaccess)
# Designed for Next.js Deployments on Apache / cPanel / Shared Hosting
# ====================================================================

# 1. MIME TYPES DEFINITION (Ensures CSS, JS, and Fonts are Never Misinterpreted)
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/jpeg .jpeg .jpg
  AddType image/png .png
  AddType image/x-icon .ico
</IfModule>

# 2. URL REWRITING & ROUTING (Prevents 404 on Reload & Prevents CSS Loss)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS (Recommended for financial distributor website)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # NEVER rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # CRITICAL: NEVER rewrite _next/ static assets to index.html!
  # If a CSS or JS chunk in _next is missing, return a true 404 rather than HTML.
  # This guarantees browsers never receive HTML for a .css file, preventing missing CSS styling.
  RewriteRule ^_next/(.*)$ - [L]

  # Clean URL routing: if requesting /services and services.html exists, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Sub-folder index routing: if requesting /blogs and /blogs/index.html exists, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # Single Page Application (SPA) fallback to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# 3. CUSTOM ERROR DOCUMENT
ErrorDocument 404 /404.html

# 4. GZIP COMPRESSION (mod_deflate) - Faster Loading & Instant CSS Delivery
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 5. BROWSER CACHING HEADERS (mod_expires & mod_headers)
<IfModule mod_expires.c>
  ExpiresActive On

  # Next.js immutable static assets (CSS, JS, media in _next/static)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"

  # HTML documents - Never cache so route updates are seen immediately
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Prevent MIME type sniffing security risks
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"

  # Ensure HTML is revalidated while static assets are cached
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  <FilesMatch "\.(css|js|woff2|woff|webp|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 6. DISABLE DIRECTORY LISTING
Options -Indexes
